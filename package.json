{
  "name": "blade2php",
  "version": "0.1.3",
  "description": "Laravel's Blade compiler in pure JavaScript: .blade.php -> the exact PHP bytes Illuminate\\View\\Compilers\\BladeCompiler produces. No PHP runtime, no Composer.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "oracle": "node tests/oracle/run.mjs",
    "record": "node tests/oracle/record.mjs",
    "crosscheck": "node tests/xxcheck.mjs",
    "fuzz": "node tests/oracle/fuzz.mjs",
    "oracle:versions": "node tests/oracle/run-versions.mjs",
    "oracle:discovery": "node tests/oracle/check-discovery.mjs",
    "record:versions": "node tests/oracle/record-versions.mjs"
  },
  "keywords": [
    "blade",
    "laravel",
    "compiler",
    "template",
    "php",
    "edge",
    "workers",
    "ssr"
  ],
  "author": "arfoux",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./components": "./src/components.mjs",
    "./discovery": "./src/discovery.mjs",
    "./versions": "./src/versions.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.mjs",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "php-parser": "3.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arfoux/blade2php.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
